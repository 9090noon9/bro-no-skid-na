                        function element:set_value(new_value, cb)
                            value = new_value or value
                            menu.values[tab.tab_num][section_name][sector_name][flag] = value
                            if is_combo then element.update_text()
                            else DBT.Text = value.Dropdown end
                            for _, db in next, DropdownScroll:GetChildren() do
                                if not db:IsA("TextButton") then continue end
                                local bt = db:FindFirstChild("ButtonText")
                                local dec = db:FindFirstChild("Decoration")
                                if not bt or not dec then continue end
                                local selected = is_combo and table.find(value.Combo, bt.Text) or (not is_combo and bt.Text == value.Dropdown)
                                dec.Visible = selected and true or false
                                bt.TextColor3 = selected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 150)
                            end
                            if not cb then do_callback() end
                        end

                        for _, v in next, data.options do
                            local Button = library:create("TextButton", {
                                Name = v,
                                BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                                BorderColor3 = Color3.fromRGB(0, 0, 0),
                                BorderSizePixel = 0,
                                Size = UDim2.new(1, 0, 0, 20),
                                AutoButtonColor = false,
                                Text = "",
                                ZIndex = 2,
                            }, DropdownScroll)

                            local BT = library:create("TextLabel", {
                                Name = "ButtonText",
                                BackgroundTransparency = 1,
                                Position = UDim2.new(0, 8, 0, 0),
                                Size = UDim2.new(0, 245, 1, 0),
                                Font = Enum.Font.Ubuntu,
                                Text = v,
                                TextColor3 = Color3.fromRGB(150, 150, 150),
                                TextSize = 14,
                                TextXAlignment = Enum.TextXAlignment.Left,
                                ZIndex = 2,
                            }, Button)

                            local Decoration = library:create("Frame", {
                                Name = "Decoration",
                                BackgroundColor3 = Color3.fromRGB(84, 101, 255),
                                BorderSizePixel = 0,
                                Size = UDim2.new(0, 1, 1, 0),
                                Visible = false,
                                ZIndex = 2,
                            }, Button)

                            Button.MouseEnter:Connect(function()
                                library:tween(BT, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)})
                                if not is_combo then Decoration.Visible = true end
                            end)
                            Button.MouseLeave:Connect(function()
                                local sel = is_combo and table.find(value.Combo, v) or (not is_combo and v == value.Dropdown)
                                if not sel then
                                    library:tween(BT, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)})
                                    if not is_combo then Decoration.Visible = false end
                                end
                            end)
                            Button.MouseButton1Down:Connect(function()
                                if is_combo then
                                    if table.find(value.Combo, v) then
                                        table.remove(value.Combo, table.find(value.Combo, v))
                                        Decoration.Visible = false
                                        library:tween(BT, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)})
                                    else
                                        table.insert(value.Combo, v)
                                        library:tween(BT, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)})
                                        Decoration.Visible = true
                                    end
                                    element.update_text()
                                else
                                    DropdownScroll.Visible = false
                                    DBT.Text = v
                                    value.Dropdown = v
                                    library:tween(DropdownText, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)})
                                    library:tween(DBT, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)})
                                end
                                do_callback()
                            end)
                        end
                        element:set_value(value, true)

                    elseif type == "Button" then
                        Border.Size = Border.Size + UDim2.new(0, 0, 0, 30)
                        local BF = library:create("Frame", {
                            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30),
                        }, Container)
                        local B = library:create("TextButton", {
                            AnchorPoint = Vector2.new(0.5, 0.5),
                            BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                            BorderColor3 = Color3.fromRGB(0, 0, 0),
                            Position = UDim2.new(0.5, 0, 0.5, 0),
                            Size = UDim2.new(0, 215, 0, 20),
                            AutoButtonColor = false,
                            Font = Enum.Font.Ubuntu,
                            Text = text,
                            TextColor3 = Color3.fromRGB(150, 150, 150),
                            TextSize = 14,
                        }, BF)
                        B.MouseEnter:Connect(function() library:tween(B, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)}) end)
                        B.MouseLeave:Connect(function() library:tween(B, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)}) end)
                        B.MouseButton1Down:Connect(function()
                            B.BorderColor3 = Color3.fromRGB(84, 101, 255)
                            library:tween(B, TweenInfo.new(0.6), {BorderColor3 = Color3.fromRGB(0, 0, 0)})
                            do_callback()
                        end)

                    elseif type == "TextBox" then
                        Border.Size = Border.Size + UDim2.new(0, 0, 0, 30)
                        value = {Text = data.default and data.default or ""}
                        local BF = library:create("Frame", {
                            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30),
                        }, Container)
                        function element:set_visible(bool)
                            if bool then
                                if BF.Visible then return end
                                Border.Size = Border.Size + UDim2.new(0, 0, 0, 30)
                                BF.Visible = true
                            else
                                if not BF.Visible then return end
                                Border.Size = Border.Size + UDim2.new(0, 0, 0, -30)
                                BF.Visible = false
                            end
                        end
                        local TB = library:create("TextBox", {
                            AnchorPoint = Vector2.new(0.5, 0.5),
                            BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                            BorderColor3 = Color3.fromRGB(0, 0, 0),
                            Position = UDim2.new(0.5, 0, 0.5, 0),
                            Size = UDim2.new(0, 215, 0, 20),
                            Font = Enum.Font.Ubuntu,
                            Text = "",
                            TextColor3 = Color3.fromRGB(150, 150, 150),
                            TextSize = 14,
                            PlaceholderText = text,
                            ClearTextOnFocus = false,
                        }, BF)
                        TB.MouseEnter:Connect(function() library:tween(TB, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)}) end)
                        TB.MouseLeave:Connect(function() library:tween(TB, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)}) end)
                        TB:GetPropertyChangedSignal("Text"):Connect(function()
                            if string.len(TB.Text) > 15 then TB.Text = string.sub(TB.Text, 1, 15) end
                            if TB.Text ~= value.Text then
                                value.Text = TB.Text
                                do_callback()
                            end
                        end)
                        uis.TextBoxFocused:Connect(function()
                            if uis:GetFocusedTextBox() == TB then
                                library:tween(TB, TweenInfo.new(0.3), {BorderColor3 = Color3.fromRGB(84, 101, 255)})
                            end
                        end)
                        uis.TextBoxFocusReleased:Connect(function()
                            library:tween(TB, TweenInfo.new(0.3), {BorderColor3 = Color3.fromRGB(0, 0, 0)})
                        end)
                        function element:set_value(new_value, cb)
                            value = new_value or value
                            TB.Text = value.Text
                            if not cb then do_callback() end
                        end
                        element:set_value(value, true)

                    elseif type == "Scroll" then
                        local scrollsize = data.scrollsize or 5
                        Border.Size = Border.Size + UDim2.new(0, 0, 0, scrollsize * 20 + 10)
                        value = {Scroll = data.options[1]}
                        local Scroll = library:create("Frame", {
                            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, scrollsize * 20 + 10),
                        }, Container)
                        local SF = library:create("ScrollingFrame", {
                            Active = true,
                            BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                            BorderColor3 = Color3.fromRGB(0, 0, 0),
                            Position = UDim2.new(0.5, 0, 0, 5),
                            Size = UDim2.new(0, 215, 0, scrollsize * 20),
                            CanvasSize = UDim2.new(0, 0, 0, #data.options * 20),
                            ScrollBarThickness = 2,
                            AnchorPoint = Vector2.new(0.5, 0),
                            ScrollBarImageColor3 = Color3.fromRGB(84, 101, 255),
                        }, Scroll)
                        library:create("UIListLayout", {
                            HorizontalAlignment = Enum.HorizontalAlignment.Center,
                            SortOrder = Enum.SortOrder.LayoutOrder,
                        }, SF)

                        local function make_row(v, first)
                            local B = library:create("TextButton", {
                                Name = v,
                                BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                                BorderColor3 = Color3.fromRGB(0, 0, 0),
                                BorderSizePixel = 0,
                                Size = UDim2.new(1, 0, 0, 20),
                                AutoButtonColor = false,
                                Text = "",
                            }, SF)
                            local BT = library:create("TextLabel", {
                                Name = "ButtonText",
                                BackgroundTransparency = 1,
                                Position = UDim2.new(0, 7, 0, 0),
                                Size = UDim2.new(0, 210, 1, 0),
                                Font = Enum.Font.Ubuntu,
                                Text = v,
                                TextColor3 = first and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 150),
                                TextSize = 14,
                                TextXAlignment = Enum.TextXAlignment.Left,
                            }, B)
                            local Dec = library:create("Frame", {
                                Name = "Decoration",
                                BackgroundColor3 = Color3.fromRGB(84, 101, 255),
                                BorderSizePixel = 0,
                                Size = UDim2.new(0, 1, 1, 0),
                                Visible = first,
                            }, B)
                            B.MouseEnter:Connect(function()
                                if value.Scroll ~= v then library:tween(BT, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(200, 200, 200)}) end
                            end)
                            B.MouseLeave:Connect(function()
                                if value.Scroll ~= v then library:tween(BT, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)}) end
                            end)
                            B.MouseButton1Down:Connect(function()
                                for _, b2 in next, SF:GetChildren() do
                                    if b2:IsA("TextButton") then
                                        b2.Decoration.Visible = false
                                        library:tween(b2.ButtonText, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)})
                                    end
                                end
                                menu.values[tab.tab_num][section_name][sector_name][flag] = value
                                Dec.Visible = true
                                library:tween(BT, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)})
                                value.Scroll = v
                                do_callback()
                            end)
                        end
                        local first = true
                        for _, v in next, data.options do
                            make_row(v, first)
                            first = false
                        end
                        function element:add_value(v)
                            if SF:FindFirstChild(v) then return end
                            SF.CanvasSize = SF.CanvasSize + UDim2.new(0, 0, 0, 20)
                            make_row(v, false)
                        end
                        function element:set_value(new_value, cb)
                            value = new_value or value
                            for _, b2 in next, SF:GetChildren() do
                                if b2:IsA("TextButton") then
                                    b2.Decoration.Visible = false
                                    library:tween(b2.ButtonText, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)})
                                end
                            end
                            if SF:FindFirstChild(value.Scroll) then
                                SF[value.Scroll].Decoration.Visible = true
                                library:tween(SF[value.Scroll].ButtonText, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)})
                            end
                            if not cb then do_callback() end
                        end
                        element:set_value(value, true)

                    elseif type == "Slider" then
                        Border.Size = Border.Size + UDim2.new(0, 0, 0, 35)
                        value = {Slider = default and default.default or 0}
                        local min, max = default and default.min or 0, default and default.max or 100
                        local Slider = library:create("Frame", {
                            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 35),
                        }, Container)
                        function element:set_visible(bool)
                            if bool then
                                if Slider.Visible then return end
                                Border.Size = Border.Size + UDim2.new(0, 0, 0, 35)
                                Slider.Visible = true
                            else
                                if not Slider.Visible then return end
                                Border.Size = Border.Size + UDim2.new(0, 0, 0, -35)
                                Slider.Visible = false
                            end
                        end
                        local ST = library:create("TextLabel", {
                            BackgroundTransparency = 1,
                            Position = UDim2.new(0, 9, 0, 6),
                            Size = UDim2.new(0, 200, 0, 9),
                            Font = Enum.Font.Ubuntu,
                            Text = text,
                            TextColor3 = Color3.fromRGB(150, 150, 150),
                            TextSize = 14,
                            TextXAlignment = Enum.TextXAlignment.Left,
                        }, Slider)
                        local SB = library:create("TextButton", {
                            BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                            BorderColor3 = Color3.fromRGB(0, 0, 0),
                            Position = UDim2.new(0, 9, 0, 20),
                            Size = UDim2.new(0, 260, 0, 14),
                            AutoButtonColor = false,
                            Text = "",
                        }, Slider)
                        local SFr = library:create("Frame", {
                            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                            BorderSizePixel = 0,
                            Size = UDim2.new(0, 100, 1, 0),
                        }, SB)
                        library:create("UIGradient", {
                            Color = ColorSequence.new{
                                ColorSequenceKeypoint.new(0, Color3.fromRGB(79, 95, 239)),
                                ColorSequenceKeypoint.new(1, Color3.fromRGB(56, 67, 163))
                            },
                            Rotation = 90,
                        }, SFr)
                        local SV = library:create("TextLabel", {
                            BackgroundTransparency = 1,
                            Position = UDim2.new(0, 69, 0, 6),
                            Size = UDim2.new(0, 200, 0, 9),
                            Font = Enum.Font.Ubuntu,
                            Text = tostring(value.Slider),
                            TextColor3 = Color3.fromRGB(150, 150, 150),
                            TextSize = 14,
                            TextXAlignment = Enum.TextXAlignment.Right,
                        }, Slider)

                        local function compute()
                            local tx = math.clamp(mouse.X - SB.AbsolutePosition.X, 0, 260)
                            return tx, math.floor((((max - min) / 260) * tx) + min)
                        end
                        local sliding, min_ = false, false
                        Slider.MouseEnter:Connect(function()
                            library:tween(ST, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)})
                            library:tween(SV, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)})
                            min_ = true
                        end)
                        Slider.MouseLeave:Connect(function()
                            if not sliding then
                                library:tween(ST, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)})
                                library:tween(SV, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)})
                            end
                            min_ = false
                        end)
                        local function apply()
                            local tx, val = compute()
                            SFr.Size = UDim2.new(0, tx, 1, 0)
                            if val ~= value.Slider then
                                SV.Text = tostring(val)
                                value.Slider = val
                                do_callback()
                            end
                        end
                        SB.MouseButton1Down:Connect(function()
                            apply()
                            sliding = true
                            local mc = mouse.Move:Connect(apply)
                            local rc
                            rc = uis.InputEnded:Connect(function(M)
                                if M.UserInputType == Enum.UserInputType.MouseButton1 then
                                    apply()
                                    sliding = false
                                    if not min_ then
                                        library:tween(ST, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)})
                                        library:tween(SV, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(150, 150, 150)})
                                    end
                                    mc:Disconnect()
                                    rc:Disconnect()
                                end
                            end)
                        end)
                        function element:set_value(new_value, cb)
                            value = new_value or value
                            menu.values[tab.tab_num][section_name][sector_name][flag] = value
                            local new_size = (value.Slider - min) / (max - min)
                            SFr.Size = UDim2.new(new_size, 0, 1, 0)
                            SV.Text = tostring(value.Slider)
                            if not cb then do_callback() end
                        end
                        element:set_value(value, true)
                    end

                    menu.on_load_cfg:Connect(function()
                        if type ~= "Button" and type ~= "Scroll" then
                            element:set_value(menu.values[tab.tab_num][section_name][sector_name][flag])
                        end
                    end)
                    return element
                end
                return sector
            end
            return section
        end
        return tab
    end

    return menu
end

return library
