-- ============================================================
-- notification system — call as library.notify("text")
-- top-left, Ubuntu 13, square corners, stacks, dedups
-- ============================================================
function library.notify(text)
    local CoreGui = game:GetService("CoreGui")
    local TS = game:GetService("TweenService")
    local ACCENT = Color3.fromRGB(84, 101, 255)
    local DARK = Color3.fromRGB(15, 15, 15)

    local NGui = CoreGui:FindFirstChild("cinder_notif")
    if not NGui then
        NGui = Instance.new("ScreenGui")
        NGui.Name = "cinder_notif"
        NGui.ResetOnSpawn = false
        NGui.IgnoreGuiInset = true
        NGui.DisplayOrder = 1000
        NGui.Parent = CoreGui
    end

    for _, c in ipairs(NGui:GetChildren()) do
        if c:IsA("Frame") and c:GetAttribute("t") == text then c:Destroy() end
    end

    local count = 0
    for _, c in ipairs(NGui:GetChildren()) do
        if c:IsA("Frame") then count = count + 1 end
    end
    local y = 12 + count * 36

    local card = Instance.new("Frame")
    card:SetAttribute("t", text)
    card.Position = UDim2.new(0, 12, 0, y - 8)
    card.Size = UDim2.new(0, 220, 0, 30)
    card.BackgroundColor3 = DARK
    card.BackgroundTransparency = 1
    card.BorderSizePixel = 0
    card.Parent = NGui

    local stroke = Instance.new("UIStroke")
    stroke.Color = ACCENT
    stroke.Thickness = 1
    stroke.Transparency = 1
    stroke.Parent = card

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -16, 1, 0)
    lbl.Position = UDim2.new(0, 8, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.Font = Enum.Font.Ubuntu
    lbl.TextSize = 13
    lbl.TextColor3 = Color3.new(1, 1, 1)
    lbl.TextTransparency = 1
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = card

    TS:Create(card, TweenInfo.new(0.25), {Position = UDim2.new(0, 12, 0, y), BackgroundTransparency = 0}):Play()
    TS:Create(stroke, TweenInfo.new(0.25), {Transparency = 0.3}):Play()
    TS:Create(lbl, TweenInfo.new(0.25), {TextTransparency = 0}):Play()

    task.delay(2.5, function()
        if not card.Parent then return end
        TS:Create(card, TweenInfo.new(0.25), {Position = UDim2.new(0, 4, 0, y), BackgroundTransparency = 1}):Play()
        TS:Create(stroke, TweenInfo.new(0.25), {Transparency = 1}):Play()
        TS:Create(lbl, TweenInfo.new(0.25), {TextTransparency = 1}):Play()
        task.wait(0.3)
        if card.Parent then card:Destroy() end
    end)
end

